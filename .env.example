# DeepSeek API Key（https://platform.deepseek.com）
DEEPSEEK_API_KEY=sk-your-key-here
# 默认模型（deepseek-flash 支持原生多模态，可直接做简历图片/扫描件识别）
DEEPSEEK_MODEL=deepseek-flash

# ZPAY 支付接口（https://z-pay.cn，易支付兼容，国内用户）
ZPAY_PID=your-zpay-pid
ZPAY_KEY=your-zpay-key
ZPAY_API_BASE=https://zpayz.cn
ZPAY_NOTIFY_URL=https://your-domain.com/api/pay/notify
ZPAY_RETURN_URL=https://your-domain.com/

# Creem 国际支付（https://www.creem.io，海外用户，美元计价）
# 1) Creem 后台创建两个一次性产品：简历导出 1 次、AI 次卡 1 次，把 product_id 填到下方
# 2) Developers → Webhook 创建 endpoint（URL = https://你的域名/api/pay/creem/webhook），把 Secret 填到下方
# 未配置时前端不显示 Creem 通道，不影响支付宝
CREEM_API_KEY=creem_live_xxx
CREEM_PRODUCT_EXPORT=prod_xxx
CREEM_PRODUCT_AI=prod_xxx
CREEM_WEBHOOK_SECRET=whsec_xxx
CREEM_API_BASE=https://api.creem.io
CREEM_SUCCESS_URL=https://your-domain.com/
# 美元定价（仅对账展示；Creem 产品实际价格以后台配置为准）
CREEM_EXPORT_PRICE_USD=1.00
CREEM_AI_PRICE_USD=1.00

# 页脚可选信息（部署方品牌/合规信息，开源默认留空不显示）
NEXT_PUBLIC_ICP_NUMBER=蜀ICP备XXXXXXXX号
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_FOUNDER=Your Name

# Upstash Redis（Serverless 部署如 Vercel 必配，账号/额度/订单持久化）
# 免费创建：https://console.upstash.com → Data Browser 区域建库 → REST 段落复制
# 未配置时自动回退本地文件存储（本地开发 / PM2 自托管不受影响）
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-token
